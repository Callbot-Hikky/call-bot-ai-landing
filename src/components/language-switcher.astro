---
import { languages, defaultLang, type Lang } from "@/i18n/ui";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const current = getLangFromUrl(Astro.url);
const t = useTranslations(current);

// Strip the locale prefix to get the bare path, then rebuild per locale.
const segments = Astro.url.pathname.split("/").filter(Boolean);
const bare =
  segments[0] && segments[0] in languages
    ? "/" + segments.slice(1).join("/")
    : Astro.url.pathname;

function hrefFor(lang: Lang): string {
  const path = bare === "" ? "/" : bare;

  return lang === defaultLang ? path : `/${lang}${path === "/" ? "" : path}`;
}

// Codes affichés en majuscules (FR / EN).
const options = (Object.keys(languages) as Lang[]).map((code) => ({
  value: code,
  label: code.toUpperCase(),
  href: hrefFor(code)
}));
---

{/*
  Deux liens, zéro JavaScript. Remplace un îlot React (~330 Ko bruts, hydraté
  deux fois par page) qui ne faisait qu'une redirection : le navigateur sait
  déjà suivre un lien. Bonus : fonctionne sans JS et se référence proprement
  pour le SEO multilingue.
*/}
<nav aria-label={t("nav.langAria")} class="flex items-center gap-1 text-sm">
  {
    options.map((option, i) => (
      <>
        {i > 0 && <span class="text-border" aria-hidden="true">/</span>}
        <a
          href={option.href}
          hreflang={option.value}
          aria-current={option.value === current ? "true" : undefined}
          class:list={[
            "rounded px-1 py-0.5 transition-colors hover:text-foreground",
            option.value === current
              ? "text-foreground"
              : "text-muted-foreground"
          ]}
        >
          {option.label}
        </a>
      </>
    ))
  }
</nav>
