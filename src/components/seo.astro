---
import { defaultLang, type Lang } from "@/i18n/ui";
import { getAlternates, getLangFromUrl } from "@/i18n/utils";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
}

const {
  title,
  description,
  image,
  noindex = false,
  type = "website"
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : Astro.url.href;
const alternates = site ? getAlternates(Astro.url, site) : [];
const xDefault = alternates.find((a) => a.lang === defaultLang)?.href;
const ogImage = image && site ? new URL(image, site).href : image;

const ogLocale: Record<Lang, string> = { fr: "fr_FR", en: "en_US" };
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.lang} href={alt.href} />
  ))
}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale[lang]} />
{ogImage && <meta property="og:image" content={ogImage} />}

<meta
  name="twitter:card"
  content={ogImage ? "summary_large_image" : "summary"}
/>
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{ogImage && <meta name="twitter:image" content={ogImage} />}
