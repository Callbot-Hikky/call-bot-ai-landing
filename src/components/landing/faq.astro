---
import SectionBlinds from "@/components/landing/section-blinds.astro";
import TextWhip from "@/components/landing/text-whip.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const faqs = [
  { q: t("faq.q1"), a: t("faq.a1") },
  { q: t("faq.q2"), a: t("faq.a2") },
  { q: t("faq.q3"), a: t("faq.a3") },
  { q: t("faq.q4"), a: t("faq.a4") },
  { q: t("faq.q5"), a: t("faq.a5") }
];
---

<section id="faq" class="relative mx-auto max-w-3xl px-5 py-24 md:py-32">
  {/* Les lamelles révèlent le noir : transition clair → sombre vers la CTA finale. */}
  <SectionBlinds fill="#08080c" />
  <div class="text-center">
    <TextWhip
      as="h2"
      text={t("faq.title")}
      class="hk-display text-[clamp(2.1rem,5.4vw,3.6rem)] text-foreground"
    />
  </div>

  <div class="mt-12 space-y-3">
    {
      faqs.map((faq, i) => (
        <details
          class="hk-faq group overflow-hidden rounded-2xl border border-border bg-card/30 transition-colors open:border-coral/30 open:bg-card/50"
          open={i === 0}
        >
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-medium text-foreground">
            <TextWhip as="span" text={faq.q} speed="fast" />
            {/* Signe « + » construit en CSS (deux filets), plus aucun composant
                d'icône. La classe est conservée : la rotation à l'ouverture,
                définie plus bas, continue de s'appliquer. */}
            <span
              class="hk-faq-icon relative block size-5 shrink-0 transition-transform duration-300 before:absolute before:top-1/2 before:left-0 before:h-px before:w-full before:-translate-y-1/2 before:bg-coral after:absolute after:top-0 after:left-1/2 after:h-full after:w-px after:-translate-x-1/2 after:bg-coral"
              aria-hidden="true"></span>
          </summary>
          <p class="hk-faq-body px-5 pb-5 leading-relaxed text-muted-foreground">
            {faq.a}
          </p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .hk-faq summary {
    list-style: none;
  }
  .hk-faq summary::-webkit-details-marker {
    display: none;
  }
  .hk-faq[open] .hk-faq-icon {
    transform: rotate(45deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hk-faq[open] .hk-faq-body {
      animation: hk-faq-in 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
  }
  @keyframes hk-faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
