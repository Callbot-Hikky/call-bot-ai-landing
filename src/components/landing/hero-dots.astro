---
// Fond de points interactif du hero : grille de points qui s'écartent du curseur
// (repel), puis reviennent élastiquement. Canvas léger, DPR-aware, rAF uniquement
// pendant l'activité (idle = 0 frame), gated par prefers-reduced-motion (grille
// statique sinon). Remplace la grille CSS statique. Fondu radial via mask-image.
---

<canvas
  data-hero-dots
  class="pointer-events-none absolute inset-0 -z-10 h-full w-full"
  style="mask-image:radial-gradient(ellipse 85% 80% at 50% 42%, #000 45%, transparent 100%);-webkit-mask-image:radial-gradient(ellipse 85% 80% at 50% 42%, #000 45%, transparent 100%)"
  aria-hidden="true"></canvas>

<script>
  const SPACING = 26; // écart entre points (px)
  const DOT_R = 1.3; // rayon du point (px)
  const ALPHA = 0.2; // opacité de base
  const RADIUS = 130; // rayon d'influence du curseur (px)
  const PUSH = 26; // déplacement max au centre de l'influence (px)
  const EASE = 0.12; // retour élastique vers la position d'origine

  interface Dot {
    x: number;
    y: number;
    ox: number;
    oy: number;
  }

  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-dots]");
  const hero = canvas?.closest("section") ?? null;
  const ctx = canvas?.getContext("2d") ?? null;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && hero && ctx) {
    let dots: Dot[] = [];
    let w = 0;
    let h = 0;
    const mouse = { x: -9999, y: -9999, active: false };
    let raf = 0;

    const build = (): void => {
      const rect = hero.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      dots = [];
      const cols = Math.ceil(w / SPACING);
      const rows = Math.ceil(h / SPACING);
      const offX = (w - (cols - 1) * SPACING) / 2;
      const offY = (h - (rows - 1) * SPACING) / 2;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          dots.push({ x: offX + c * SPACING, y: offY + r * SPACING, ox: 0, oy: 0 });
        }
      }
    };

    const draw = (): void => {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = `rgba(255,255,255,${ALPHA})`;

      for (const d of dots) {
        ctx.beginPath();
        ctx.arc(d.x + d.ox, d.y + d.oy, DOT_R, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const tick = (): void => {
      let moving = false;

      for (const d of dots) {
        let tx = 0;
        let ty = 0;

        if (mouse.active) {
          const dx = d.x - mouse.x;
          const dy = d.y - mouse.y;
          const dist = Math.hypot(dx, dy);

          if (dist > 0 && dist < RADIUS) {
            const force = (RADIUS - dist) / RADIUS;
            tx = (dx / dist) * force * PUSH;
            ty = (dy / dist) * force * PUSH;
          }
        }

        d.ox += (tx - d.ox) * EASE;
        d.oy += (ty - d.oy) * EASE;

        if (Math.abs(d.ox) > 0.05 || Math.abs(d.oy) > 0.05) moving = true;
      }

      draw();
      raf = moving || mouse.active ? requestAnimationFrame(tick) : 0;
    };

    const wake = (): void => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    build();
    draw();

    if (!reduced) {
      hero.addEventListener("pointermove", (e: PointerEvent) => {
        const rect = hero.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
        mouse.active = true;
        wake();
      });

      hero.addEventListener("pointerleave", () => {
        mouse.active = false;
        wake();
      });
    }

    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        build();
        draw();
      }, 200);
    });
  }
</script>
