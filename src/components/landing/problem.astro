---
import SectionBlinds from "@/components/landing/section-blinds.astro";
import TextWhip from "@/components/landing/text-whip.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pains = [
  { stat: t("problem.stat1"), body: t("problem.stat1Body") },
  { stat: t("problem.stat2"), body: t("problem.stat2Body") },
  { stat: t("problem.stat3"), body: t("problem.stat3Body") }
] as const;
---

{/*
  Pas d'icônes, pas de cartes, pas de numéros : une grille éditoriale. Le poids
  visuel vient de l'échelle et de la graisse (Instrument Sans 700, tracking
  très resserré) et des filets — pas d'un pictogramme dans une pastille.
  Le texte reste monochrome : la chaleur passe par le filet dégradé et les fonds.
*/}
<section class="relative mx-auto max-w-6xl px-5 py-24 md:py-32">
  <SectionBlinds fill="oklch(1 0 0)" />

  <h2 class="hk-display max-w-4xl text-[clamp(2.4rem,7vw,5.5rem)]">
    <TextWhip as="span" text={t("problem.title")} class="hk-whip-gradient" />{" "}
    <TextWhip
      as="span"
      text={t("problem.titleAccent")}
      class="hk-whip-gradient"
      delay={0.18}
    />
  </h2>

  <div class="mt-16 grid gap-px border-t border-border md:mt-24 md:grid-cols-3">
    {
      pains.map((pain, i) => (
        <div
          class="hk-reveal border-b border-border pt-8 pb-10 md:border-b-0 md:pr-8"
          style={`--hk-reveal-delay:${i * 110}ms`}
        >
          <TextWhip
            as="p"
            text={pain.stat}
            class="hk-display text-[clamp(1.8rem,3.4vw,2.6rem)] text-foreground"
          />

          <TextWhip
            as="p"
            text={pain.body}
            class="mt-3 max-w-sm text-base leading-relaxed text-muted-foreground"
            speed="fast"
          />
        </div>
      ))
    }
  </div>
</section>
