---
import Icon from "@/components/landing/icon.astro";
import LanguageSwitcher from "@/components/language-switcher.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { getAppUrl } from "@/lib/app-url";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const APP_URL = getAppUrl();

const links = [
  { href: "#fonctionnement", label: t("nav.how") },
  { href: "#fonctionnalites", label: t("nav.features") },
  { href: "#tarifs", label: t("nav.pricing") },
  { href: "#faq", label: t("nav.faq") }
];
---

<header
  id="site-nav"
  class="dark fixed inset-x-0 top-0 z-50 py-4 transition-all duration-300 data-[scrolled]:py-3"
>
  <div class="mx-auto max-w-6xl px-5">
    <div
      id="site-nav-bar"
      class="flex items-center justify-between rounded-2xl px-4 py-2.5 transition-all duration-300"
    >
      <a href="#top" class="hk-display text-2xl font-semibold tracking-tight text-foreground">
        Alloquence
      </a>

      <nav class="hidden items-center gap-8 md:flex" aria-label="Navigation">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-sm text-muted-foreground transition-colors hover:text-foreground"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-4 md:flex">
        <LanguageSwitcher />
        <a href={`${APP_URL}/register`} class="hk-cta px-5 py-2.5 text-sm">{t("nav.try")}</a>
      </div>

      <button
        id="site-nav-toggle"
        type="button"
        class="grid size-10 place-items-center rounded-xl border border-border text-foreground md:hidden"
        aria-label={t("nav.menu")}
        aria-expanded="false"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>

    <div
      id="site-nav-mobile"
      class="hk-glass mt-2 hidden flex-col gap-1 rounded-2xl p-3 md:hidden"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-close
            class="rounded-xl px-3 py-2.5 text-sm text-muted-foreground hover:bg-accent hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
      <div class="flex items-center justify-between px-3 py-2">
        <LanguageSwitcher />
      </div>
      <a href={`${APP_URL}/register`} data-nav-close class="hk-cta mt-1 w-full">
        {t("nav.try")}
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-nav");
  const bar = document.getElementById("site-nav-bar");
  const toggle = document.getElementById("site-nav-toggle");
  const mobile = document.getElementById("site-nav-mobile");

  // Fond vitré au défilement.
  const onScroll = (): void => {
    const scrolled = window.scrollY > 24;

    header?.toggleAttribute("data-scrolled", scrolled);
    // Tokens sombres sur le hero (en haut), glass clair au scroll.
    header?.classList.toggle("dark", !scrolled);
    bar?.classList.toggle("hk-glass", scrolled);
    bar?.classList.toggle("shadow-2xl", scrolled);
  };

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Menu mobile.
  toggle?.addEventListener("click", () => {
    const open = mobile?.classList.toggle("hidden") === false;

    mobile?.classList.toggle("flex", open);
    toggle.setAttribute("aria-expanded", String(open));
  });

  document.querySelectorAll("[data-nav-close]").forEach((el) => {
    el.addEventListener("click", () => {
      mobile?.classList.add("hidden");
      mobile?.classList.remove("flex");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
