---
// Spectre audio animé — canvas vanilla, monochrome zinc (aligné sur les tokens).
// Volontairement DISCRET : halo circulaire fin, centre bien dégagé pour le texte.
// Traînées légères, particules, parallaxe souris. Pause hors-écran + reduced-motion.
---

<canvas
  id="hk-spectrum"
  class="pointer-events-none absolute inset-0 -z-10 size-full"
  aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById("hk-spectrum") as HTMLCanvasElement | null;
  const ctx = canvas?.getContext("2d") ?? null;

  if (canvas && ctx) {
    const FG = "24, 24, 27"; // zinc-900, aligné sur --foreground
    const TWO_PI = Math.PI * 2;
    const BARS = 104;
    const seeds = Array.from(
      { length: BARS },
      (_, i) => ((Math.sin(i * 12.9898) * 43758.5453) % 1 + 1) % 1
    );
    const particles = Array.from({ length: 20 }, (_, i) => ({
      base: 1.25 + (i % 6) * 0.12,
      angle: (i / 20) * TWO_PI,
      speed: 0.00012 + (i % 5) * 0.00005,
      size: 0.6 + seeds[i] * 1.1
    }));

    let w = 0;
    let h = 0;
    let cx = 0;
    let cy = 0;
    let unit = 0;
    let dpr = 1;
    const mouse = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5 };
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const resize = (): void => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = w / 2;
      cy = h / 2;
      unit = Math.min(w, h);
    };

    // Amplitude "fréquentielle" simulée : sommes de sinus + graine par barre.
    const freq = (i: number, t: number): number => {
      const a = 0.5 + 0.5 * Math.sin(t * 0.8 + i * 0.2);
      const b = 0.5 + 0.5 * Math.sin(t * 1.5 - i * 0.11 + 1.3);
      const c = 0.5 + 0.5 * Math.sin(t * 0.45 + i * 0.37 + seeds[i] * 6);
      return a * 0.5 + b * 0.3 + c * 0.2;
    };

    const draw = (time: number): void => {
      const t = time * 0.001;

      mouse.x += (mouse.tx - mouse.x) * 0.05;
      mouse.y += (mouse.ty - mouse.y) * 0.05;
      const px = (mouse.x - 0.5) * unit * 0.04;
      const py = (mouse.y - 0.5) * unit * 0.04;

      // Traînée : on efface progressivement (destination-out) → canvas
      // transparent, le mesh derrière transparaît, les barres laissent un sillage.
      ctx.globalCompositeOperation = "destination-out";
      ctx.fillStyle = "rgba(0, 0, 0, 0.3)";
      ctx.fillRect(0, 0, w, h);
      ctx.globalCompositeOperation = "source-over";

      const ox = cx + px;
      const oy = cy + py;
      // Rayon interne LARGE → anneau loin du texte, centre dégagé.
      const baseR = unit * 0.4;
      const maxLen = unit * 0.16;
      const rot = t * 0.05;

      // Spectre circulaire (deux couches contra-rotatives, très légères).
      const layers = [
        { dir: 1, width: 1.7, alpha: 0.22, base: 0.04, r: baseR, len: maxLen },
        { dir: -1, width: 1, alpha: 0.1, base: 0.02, r: baseR * 1.14, len: maxLen * 0.55 }
      ];

      for (const layer of layers) {
        ctx.save();
        ctx.translate(ox, oy);
        ctx.rotate(rot * layer.dir);
        ctx.lineCap = "round";
        ctx.lineWidth = layer.width;
        for (let i = 0; i < BARS; i++) {
          const amp = freq(i, t);
          const len = amp * layer.len;
          const ang = (i / BARS) * TWO_PI;
          const cos = Math.cos(ang);
          const sin = Math.sin(ang);
          ctx.strokeStyle = `rgba(${FG}, ${(layer.base + amp * layer.alpha).toFixed(3)})`;
          ctx.beginPath();
          ctx.moveTo(cos * layer.r, sin * layer.r);
          ctx.lineTo(cos * (layer.r + len), sin * (layer.r + len));
          ctx.stroke();
        }
        ctx.restore();
      }

      // Particules orbitales lointaines.
      ctx.fillStyle = `rgba(${FG}, 0.18)`;
      for (const p of particles) {
        const ang = p.angle + t * p.speed * 1000;
        const r = baseR * p.base + Math.sin(t * 0.7 + p.angle) * unit * 0.015;
        ctx.beginPath();
        ctx.arc(ox + Math.cos(ang) * r, oy + Math.sin(ang) * r, p.size, 0, TWO_PI);
        ctx.fill();
      }
    };

    let raf = 0;
    let running = false;

    const loop = (time: number): void => {
      draw(time);
      raf = requestAnimationFrame(loop);
    };

    const start = (): void => {
      if (running) return;
      running = true;
      raf = requestAnimationFrame(loop);
    };
    const stop = (): void => {
      running = false;
      cancelAnimationFrame(raf);
    };

    resize();
    window.addEventListener("resize", resize);
    window.addEventListener("pointermove", (e) => {
      mouse.tx = e.clientX / window.innerWidth;
      mouse.ty = e.clientY / window.innerHeight;
    });

    if (reduced) {
      draw(1200);
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              start();
            } else {
              stop();
            }
          }
        },
        { threshold: 0 }
      );
      io.observe(canvas);
    }
  }
</script>
