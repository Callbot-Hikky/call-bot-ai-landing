---
import SectionBlinds from "@/components/landing/section-blinds.astro";
import TextWhip from "@/components/landing/text-whip.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
  { title: t("features.f1Title"), body: t("features.f1Body") },
  { title: t("features.f2Title"), body: t("features.f2Body") },
  { title: t("features.f3Title"), body: t("features.f3Body") },
  { title: t("features.f4Title"), body: t("features.f4Body") },
  { title: t("features.f5Title"), body: t("features.f5Body") },
  { title: t("features.f6Title"), body: t("features.f6Body") }
] as const;
---

{/*
  Mur typographique : plus de cartes à pictogramme, plus de numéros. Chaque
  entrée est une ligne de grille séparée par un filet, titre en Instrument
  Sans 700. Le survol ne fait qu'avancer le texte — aucun halo, aucun anneau.
*/}
<section
  id="fonctionnalites"
  class="relative mx-auto max-w-6xl px-5 py-24 md:py-32"
>
  <SectionBlinds fill="color-mix(in oklab, oklch(0.967 0.001 286.375) 60%, oklch(1 0 0))" />

  <TextWhip
    as="h2"
    text={t("features.title")}
    class="hk-display hk-whip-gradient max-w-3xl text-[clamp(2.4rem,7vw,5.5rem)]"
  />

  <div class="mt-16 border-t border-border md:mt-24">
    {
      features.map((feature, i) => (
        <article
          class="hk-feature hk-reveal grid gap-x-10 border-b border-border py-8 md:grid-cols-[minmax(0,20rem)_1fr] md:py-10"
          style={`--hk-reveal-delay:${(i % 3) * 90}ms`}
        >
          <TextWhip
            as="h3"
            text={feature.title}
            class="hk-display text-[clamp(1.5rem,3vw,2.2rem)] text-foreground"
          />

          <TextWhip
            as="p"
            text={feature.body}
            class="mt-3 max-w-xl text-base leading-relaxed text-muted-foreground md:mt-0 md:pt-1"
            speed="fast"
          />
        </article>
      ))
    }
  </div>
</section>

<style>
  /* Le seul feedback au survol : la ligne avance. Pas de halo, pas de carte. */
  .hk-feature {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .hk-feature:hover {
      transform: translateX(0.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hk-feature {
      transition: none;
    }

    .hk-feature:hover {
      transform: none;
    }
  }
</style>
