---
// Animation « whip in up » mot par mot, 100 % Astro/CSS (inspirée de Cult UI).
// Les mots sont découpés au build ; l'IntersectionObserver global ajoute
// `.hk-whip--in` à l'entrée dans le viewport → chaque mot remonte depuis son
// masque, avec un décalage (stagger). Respecte prefers-reduced-motion.

interface Props {
  text: string;
  as?: keyof astroHTML.JSX.IntrinsicElements;
  class?: string;
  delay?: number;
  speed?: "normal" | "fast";
}

const {
  text,
  as: Tag = "h2",
  class: className = "",
  delay = 0,
  speed = "normal"
} = Astro.props;
const words: string[] = text.split(" ");
---

<Tag
  class:list={["hk-whip", speed === "fast" && "hk-whip--fast", className]}
  style={`--hk-whip-delay:${delay}s`}
>
  {
    words.map((word, i) => (
      <Fragment>
        <span class="hk-whip-word">
          <span class="hk-whip-inner" style={`--i:${i}`}>{word}</span>
        </span>
        {i < words.length - 1 ? " " : ""}
      </Fragment>
    ))
  }
</Tag>
