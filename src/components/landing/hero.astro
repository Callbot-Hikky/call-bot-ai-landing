---
import HeroBlinds from "@/components/landing/hero-blinds.astro";
import HeroDots from "@/components/landing/hero-dots.astro";
import Icon from "@/components/landing/icon.astro";
import MeshGradient from "@/components/landing/mesh-gradient.astro";
import TextWhip from "@/components/landing/text-whip.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { getAppUrl } from "@/lib/app-url";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const APP_URL = getAppUrl();
---

<section
  id="top"
  class="dark relative isolate flex min-h-dvh flex-col items-center justify-center overflow-hidden px-5 text-center"
  style="background:#08080c"
>
  {/* Aurora / mesh gradient (le « spectre audio ») */}
  <MeshGradient />

  {/* Grille de points interactive (repel au survol) */}
  <HeroDots />

  {/* Vignette pour asseoir le texte */}
  <div
    class="pointer-events-none absolute inset-0 -z-[5]"
    style="background:radial-gradient(ellipse 44% 40% at 50% 44%, rgba(8,8,12,0.55), transparent 72%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-4xl">
    <h1 class="hk-display text-balance text-[clamp(2.1rem,5.4vw,4rem)] text-foreground">
      <TextWhip as="span" text={t("hero.titleLine1")} />{" "}
      <TextWhip as="span" text={t("hero.titleAccent")} class="italic" delay={0.35} />
    </h1>

    <TextWhip
      as="p"
      text={t("hero.subtitle")}
      class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-muted-foreground"
      delay={0.55}
    />

    <div
      class="hero-anim mt-9 flex flex-wrap items-center justify-center gap-3"
      style="--d:.26s"
    >
      <a href={`${APP_URL}/register`} class="hk-cta">
        {t("hero.ctaPrimary")}
        <Icon name="arrow-right" size={16} />
      </a>
      <a href="#fonctionnement" class="hk-cta-ghost">
        <Icon name="play" size={16} />
        {t("hero.ctaSecondary")}
      </a>
    </div>
  </div>

  {/* Indice de scroll */}
  <div
    class="hero-anim absolute bottom-8 left-1/2 -translate-x-1/2 text-muted-foreground"
    style="--d:.5s"
    aria-hidden="true"
  >
    <span class="block size-6 animate-bounce">
      <Icon name="arrow-right" size={22} class="rotate-90" />
    </span>
  </div>

  {/* Transition « Horizontal Blinds » vers la section suivante */}
  <HeroBlinds />
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-anim {
      opacity: 0;
      animation: hk-rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: var(--d, 0s);
    }
  }
</style>
