---
// Transition « lamelles » réutilisable, dérivée de hero-blinds. Full-bleed via
// w-screen + left-1/2 pour échapper aux containers max-w-* de chaque section.
// Les lamelles s'ouvrent quand la section SORT du viewport (progress basé sur le
// bas de section) afin de ne pas recouvrir le contenu des sections hautes.
// `fill` = couleur de fond de la section suivante (révélée par l'ouverture).
// 0 dépendance, rAF uniquement, gated par prefers-reduced-motion.
interface Props {
  fill: string;
}

const { fill } = Astro.props;
---

<svg
  data-section-blinds
  class="pointer-events-none absolute left-1/2 top-0 z-30 h-full w-screen -translate-x-1/2"
  style={`--blind-fill:${fill}`}
  viewBox="0 0 100 100"
  preserveAspectRatio="none"
  aria-hidden="true"
>
</svg>

<style is:global>
  [data-section-blinds] rect {
    fill: var(--blind-fill, oklch(1 0 0));
  }
</style>

<script>
  const BLIND_COUNT = 24;
  const STAGGER_SPAN = 0.45; // part de la progression consommée par la cascade
  const START_RATIO = 0.35; // délai avant ouverture (en fraction de viewport) — laisse le temps de lire
  const END_RATIO = 0.8; // fraction du viewport sur laquelle se joue la sortie
  const SVG_NS = "http://www.w3.org/2000/svg";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const svgs = Array.from(
    document.querySelectorAll<SVGSVGElement>("[data-section-blinds]")
  );

  if (!reduced && svgs.length) {
    const easeOut = (x: number): number => 1 - Math.pow(1 - x, 3);
    const bandHeight = 100 / BLIND_COUNT;
    const halfMax = bandHeight / 2;

    const instances = svgs
      .map((svg) => {
        const section = svg.closest("section");
        const bands: SVGRectElement[] = [];

        for (let i = 0; i < BLIND_COUNT; i++) {
          const rect = document.createElementNS(SVG_NS, "rect");
          const centerY = (i + 0.5) * bandHeight;

          rect.setAttribute("x", "0");
          rect.setAttribute("width", "100");
          rect.setAttribute("y", String(centerY));
          rect.setAttribute("height", "0");
          rect.setAttribute("shape-rendering", "crispEdges");
          svg.appendChild(rect);
          bands.push(rect);
        }

        return { section, bands };
      })
      .filter(
        (inst): inst is { section: HTMLElement; bands: SVGRectElement[] } =>
          inst.section !== null
      );

    // Purement lié au scroll et symétrique : inverser le sens rejoue l'animation
    // en arrière, sans saut. Le délai de lecture (START_RATIO) est identique dans
    // les deux sens.
    const render = (): void => {
      const vh = window.innerHeight || document.documentElement.clientHeight;

      for (const { section, bands } of instances) {
        const past = vh - section.getBoundingClientRect().bottom - vh * START_RATIO;
        const progress = Math.min(Math.max(past / (vh * END_RATIO), 0), 1);

        for (let i = 0; i < BLIND_COUNT; i++) {
          const start = (i / (BLIND_COUNT - 1)) * STAGGER_SPAN;
          const local = Math.min(
            Math.max((progress - start) / (1 - STAGGER_SPAN), 0),
            1
          );
          const eased = easeOut(local);
          const centerY = (i + 0.5) * bandHeight;

          bands[i].setAttribute("y", String(centerY - halfMax * eased));
          bands[i].setAttribute("height", String(bandHeight * eased));
        }
      }
    };

    let ticking = false;
    const onScroll = (): void => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        render();
        ticking = false;
      });
    };

    render();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
  }
</script>
