---
import SectionBlinds from "@/components/landing/section-blinds.astro";
import TextWhip from "@/components/landing/text-whip.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [
  { title: t("how.s1Title"), body: t("how.s1Body") },
  { title: t("how.s2Title"), body: t("how.s2Body") },
  { title: t("how.s3Title"), body: t("how.s3Body") }
];
---

{/*
  Mise en page simple et robuste. Le scroll pinné précédent superposait les
  trois étapes dans une même cellule de grille : des blocs de hauteurs
  différentes finissaient par se chevaucher. Révélation au scroll par
  l'IntersectionObserver global, zéro JavaScript propre à la section.
*/}
<section
  id="fonctionnement"
  class="relative border-y border-border bg-muted/60"
>
  <SectionBlinds fill="oklch(1 0 0)" />

  <div class="mx-auto max-w-6xl px-5 py-24 md:py-32">
    <h2 class="hk-display max-w-3xl text-[clamp(2.4rem,7vw,5.5rem)]">
      <TextWhip as="span" text={t("how.title")} class="hk-whip-gradient" />
    </h2>

    <div class="mt-16 grid gap-x-10 gap-y-12 md:mt-24 md:grid-cols-3">
      {
        steps.map((step, i) => (
          <div class="hk-reveal" style={`--hk-reveal-delay:${i * 120}ms`}>
            <span class="block h-px w-full bg-border" aria-hidden="true" />

            <TextWhip
              as="h3"
              text={step.title}
              class="hk-display mt-6 text-[clamp(1.5rem,3vw,2.2rem)] text-foreground"
            />

            <TextWhip
              as="p"
              text={step.body}
              class="mt-4 text-base leading-relaxed text-muted-foreground"
              speed="fast"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
