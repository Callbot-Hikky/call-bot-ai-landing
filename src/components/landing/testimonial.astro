---
import Icon from "@/components/landing/icon.astro";
import SectionBlinds from "@/components/landing/section-blinds.astro";
import TextWhip from "@/components/landing/text-whip.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stars = [0, 1, 2, 3, 4];
---

<section class="relative mx-auto max-w-5xl px-5 py-24 md:py-32">
  <SectionBlinds fill="oklch(1 0 0)" />
  <div class="hk-reveal">
    <figure
      class="relative overflow-hidden rounded-[32px] border border-border bg-card/40 p-8 md:p-14"
    >
      <div class="hk-glow pointer-events-none absolute -right-10 -top-10 size-64 opacity-40"></div>
      <Icon name="quote" size={40} class="relative text-coral" />

      <TextWhip
        as="blockquote"
        text={`« ${t("testimonial.quote")} »`}
        class="hk-display relative mt-6 text-[clamp(1.6rem,3.4vw,2.6rem)] leading-tight text-foreground"
      />

      <figcaption class="relative mt-8 flex items-center gap-4">
        <span
          class="grid size-12 place-items-center rounded-full text-background"
          style="background-image:linear-gradient(135deg,var(--color-amber),var(--color-coral))"
        >
          <span class="hk-display text-lg font-semibold">YB</span>
        </span>
        <div>
          <TextWhip
            as="p"
            text={t("testimonial.author")}
            class="font-semibold text-foreground"
            speed="fast"
          />
          <TextWhip
            as="p"
            text={t("testimonial.role")}
            class="text-sm text-muted-foreground"
            speed="fast"
          />
        </div>
        <div class="ml-auto hidden items-center gap-1 text-amber sm:flex">
          {stars.map(() => <Icon name="star" size={16} class="fill-amber" />)}
        </div>
      </figcaption>
    </figure>
  </div>
</section>
