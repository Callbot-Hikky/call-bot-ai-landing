---
import Icon from "@/components/landing/icon.astro";
import SectionBlinds from "@/components/landing/section-blinds.astro";
import TextWhip from "@/components/landing/text-whip.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const bars = Array.from({ length: 36 }, (_, i) => i);
---

<section id="demo" class="relative mx-auto max-w-6xl px-5 pb-24 md:pb-32">
  <SectionBlinds fill="color-mix(in oklab, oklch(0.967 0.001 286.375) 60%, oklch(1 0 0))" />
  <div class="hk-reveal">
    <div
      class="relative overflow-hidden rounded-[36px] border border-border bg-muted/60 px-6 py-16 text-center md:py-24"
    >
      <div class="hk-glow pointer-events-none absolute -left-20 top-0 size-96 opacity-50"></div>
      <div
        class="hk-glow pointer-events-none absolute -right-20 bottom-0 size-96 opacity-40"
        style="animation-delay:-4s"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 top-8 mx-auto flex h-10 max-w-xs items-center justify-center gap-[3px] opacity-30"
        aria-hidden="true"
      >
        {
          bars.map((i) => (
            <span
              class="w-[3px] origin-center rounded-full animate-wave"
              style={`height:100%;background-image:linear-gradient(to top,var(--color-amber),var(--color-coral));animation-delay:${(i % 8) * 0.08}s;animation-duration:${0.85 + (i % 5) * 0.13}s`}
            />
          ))
        }
      </div>

      <h2
        class="hk-display relative mx-auto max-w-3xl text-[clamp(2.2rem,5.4vw,4rem)] text-foreground"
      >
        <TextWhip as="span" text={t("cta.title")} />{" "}
        <TextWhip
          as="span"
          text={t("cta.titleAccent")}
          class="hk-whip-gradient"
          delay={0.18}
        />
      </h2>
      <TextWhip
        as="p"
        text={t("cta.subtitle")}
        class="relative mx-auto mt-5 max-w-xl text-lg text-muted-foreground"
        speed="fast"
      />

      <div class="relative mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="mailto:hello@hikyy.fr" class="hk-cta">
          {t("cta.primary")}
          <Icon name="arrow-right" size={16} />
        </a>
        <a href="tel:+33000000000" class="hk-cta-ghost">
          <Icon name="phone-call" size={16} class="text-amber" />
          {t("cta.secondary")}
        </a>
      </div>
    </div>
  </div>
</section>
