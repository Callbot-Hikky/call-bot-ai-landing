---
import Icon from "@/components/landing/icon.astro";
import SectionBlinds from "@/components/landing/section-blinds.astro";
import TextWhip from "@/components/landing/text-whip.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const names = [
  "Le Petit Jardin",
  "Bistrot du Marché",
  "La Table d'Olivia",
  "Chez Marcel",
  "Osteria Nova",
  "Le Comptoir 12",
  "Braise & Sel",
  "Maison Lune"
];
const loop = [...names, ...names];
---

<section class="relative border-y border-border bg-muted/60 py-8">
  <SectionBlinds fill="oklch(1 0 0)" />
  <TextWhip
    as="p"
    text={t("marquee.label")}
    class="mb-6 text-center text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground"
    speed="fast"
  />
  <div class="hk-fade-x relative overflow-hidden">
    <div class="flex w-max animate-marquee items-center gap-10">
      {
        loop.map((name) => (
          <span class="flex shrink-0 items-center gap-2.5 text-lg text-muted-foreground/60">
            <Icon name="utensils-crossed" size={16} class="text-coral/70" />
            <span class="hk-display italic">{name}</span>
          </span>
        ))
      }
    </div>
  </div>
</section>
